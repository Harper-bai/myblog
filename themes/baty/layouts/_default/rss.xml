{{- /*
  [INPUT]: 当前 RSS 输出页面的 .RegularPages；首页会过滤到 posts/journal；描述文案来自 i18n
  [OUTPUT]: RSS 2.0 feed，最多包含站点两类内容，排除 About/Search
  [POS]: 覆盖 Hugo 内建 RSS 模板。首页与 section 的 /index.xml 共用。
  [PROTOCOL]: 变更时更新此头部，然后检查 AGENTS.md
*/ -}}
{{- $sections := slice "posts" "journal" -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" $sections -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ i18n "recentContent" (dict "Title" site.Title) }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
