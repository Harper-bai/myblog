---
import { type CollectionEntry } from 'astro:content';
import { getEstimatedWordCount } from '../utils/common-utils';

type Props = { post: CollectionEntry<'blog' | 'notes' | 'diary'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { post, class: className, headingLevel = 'h2' } = Astro.props;
const { title, publishDate, excerpt, isFeatured } = post.data;
const TitleTag = headingLevel;
const wordCount = getEstimatedWordCount(post.body);
const compactDate = `${publishDate.getFullYear()}-${String(publishDate.getMonth() + 1).padStart(2, '0')}-${String(publishDate.getDate()).padStart(2, '0')}`;
---

<a class:list={['post-preview group block py-3 sm:py-4', className]} href={`/${post.collection}/${post.id}/`}>
    <div class="grid grid-cols-[8.5rem_minmax(0,1fr)] items-start gap-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
        <div class="pt-1 text-xs font-sans text-main/60 sm:text-sm">
            <div class="leading-tight whitespace-nowrap">
                <time datetime={compactDate}>{compactDate}</time>
                <span class="post-divider-inline" aria-hidden="true"> · </span>
                <span>{wordCount}字</span>
                {
                    isFeatured && (
                        <>
                            <span class="post-divider-inline" aria-hidden="true">
                                {' '}
                                ·{' '}
                            </span>
                            <span class="featured-mark">置顶</span>
                        </>
                    )
                }
            </div>
        </div>
        <div class="min-w-0">
            <TitleTag class="post-preview-title text-lg leading-tight font-cang font-medium sm:text-xl">{title}</TitleTag>
            {excerpt && <p class="mt-1.5 text-sm leading-relaxed text-main/80">{excerpt}</p>}
        </div>
    </div>
</a>

<style>
    .post-preview {
        transition: background-color 0.18s ease;
    }

    .post-preview-title {
        transition:
            opacity 0.18s ease,
            text-decoration-color 0.18s ease;
    }

    .post-preview:hover .post-preview-title {
        opacity: 0.88;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
    }

    .post-divider-inline {
        opacity: 0.5;
    }

    .featured-mark {
        letter-spacing: 0.03em;
    }

    @media (prefers-reduced-motion: reduce) {
        .post-preview,
        .post-preview-title {
            transition: none;
        }
    }
</style>
