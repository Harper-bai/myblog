---
/**
 * [INPUT]: 依赖 Astro 当前 pathname 与调用方传入的链接属性
 * [OUTPUT]: 对外提供带当前页状态与 aria-current 语义的导航链接
 * [POS]: components 的导航状态适配器；被 Nav 消费，不承载导航布局样式
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, '');
---

<a class:list={[className, { 'nav-link-active': isActive }]} aria-current={isActive ? 'page' : undefined} href={href} {...props}>
    <slot />
</a>
