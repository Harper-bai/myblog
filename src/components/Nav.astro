---
/**
 * [INPUT]: 依赖 site-config 的导航项与 GitHub 社交链接，依赖 NavLink 的当前页判断，依赖 ThemeToggle 的主题切换
 * [OUTPUT]: 对外提供左侧站点入口、右侧主导航、Projects 占位项、GitHub 图标与主题切换的全站导航栏
 * [POS]: components 的全站导航编排器；桌面端保持宽幅留白，移动端收束为可展开菜单
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
const githubLink = siteConfig.socialLinks?.find((link) => link.text.toLowerCase().includes('github'));
---

<nav class="site-nav">
    <div class="site-nav-inner">
        <a href="/" class="nav-avatar z-30 relative" aria-label="返回首页">
            <img src="/avatar.png" alt="Harper Bai" width="48" height="48" decoding="async" />
        </a>

        <div class="site-nav-right">
            {
                navLinks.length > 0 && (
                    <div class="nav-menu-shell">
                        <button
                            class="menu-toggle cursor-pointer w-8 h-8 -ml-1 flex items-center justify-center relative z-30 md:hidden"
                            aria-label="Open Menu"
                            aria-expanded="false"
                            aria-controls="menu-items"
                        >
                            <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                        </button>

                        <ul
                            id="menu-items"
                            class="menu max-md:flex-col max-md:gap-1 max-md:absolute max-md:-top-2 max-md:-right-2 max-md:max-w-64 max-md:px-4 max-md:pt-14 max-md:pb-5 max-md:z-20 max-md:bg-main max-md:border max-md:border-main/10 md:items-center"
                        >
                            {navLinks.map((link) => (
                                <li class="py-1">
                                    {
                                        link.disabled ? (
                                            <span class="nav-link nav-link-disabled font-sans" aria-disabled="true">{link.text}</span>
                                        ) : (
                                            <NavLink
                                                class="nav-link font-sans"
                                                href={link.href}
                                            >
                                                {link.text}
                                            </NavLink>
                                        )
                                    }
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
            <div class="nav-tools">
                {
                    githubLink && (
                        <a
                            class="nav-icon-link"
                            href={githubLink.href}
                            target="_blank"
                            rel="noreferrer"
                            aria-label="GitHub"
                            title="GitHub"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M10.07 20.503a1 1 0 0 0-1.18-.983c-1.31.24-2.963.276-3.402-.958a5.7 5.7 0 0 0-1.837-2.415a1 1 0 0 1-.167-.11a1 1 0 0 0-.93-.645h-.005a1 1 0 0 0-1 .995c-.004.815.81 1.338 1.141 1.514a4.4 4.4 0 0 1 .924 1.36c.365 1.023 1.423 2.576 4.466 2.376l.003.098l.004.268a1 1 0 0 0 2 0l-.005-.318c-.005-.19-.012-.464-.012-1.182M20.737 5.377q.049-.187.09-.42a6.3 6.3 0 0 0-.408-3.293a1 1 0 0 0-.615-.58c-.356-.12-1.67-.357-4.184 1.25a13.9 13.9 0 0 0-6.354 0C6.762.75 5.455.966 5.102 1.079a1 1 0 0 0-.631.584a6.3 6.3 0 0 0-.404 3.357q.037.191.079.354a6.27 6.27 0 0 0-1.256 3.83a8 8 0 0 0 .043.921c.334 4.603 3.334 5.984 5.424 6.459a5 5 0 0 0-.118.4a1 1 0 0 0 1.942.479a1.7 1.7 0 0 1 .468-.878a1 1 0 0 0-.546-1.745c-3.454-.395-4.954-1.802-5.18-4.899a7 7 0 0 1-.033-.738a4.26 4.26 0 0 1 .92-2.713a3 3 0 0 1 .195-.231a1 1 0 0 0 .188-1.025a3.4 3.4 0 0 1-.155-.555a4.1 4.1 0 0 1 .079-1.616a7.5 7.5 0 0 1 2.415 1.18a1 1 0 0 0 .827.133a11.8 11.8 0 0 1 6.173.001a1 1 0 0 0 .83-.138a7.6 7.6 0 0 1 2.406-1.19a4 4 0 0 1 .087 1.578a3.2 3.2 0 0 1-.169.607a1 1 0 0 0 .188 1.025c.078.087.155.18.224.268A4.12 4.12 0 0 1 20 9.203a7 7 0 0 1-.038.777c-.22 3.056-1.725 4.464-5.195 4.86a1 1 0 0 0-.546 1.746a1.63 1.63 0 0 1 .466.908a3 3 0 0 1 .093.82v2.333c-.01.648-.01 1.133-.01 1.356a1 1 0 1 0 2 0c0-.217 0-.692.01-1.34v-2.35a5 5 0 0 0-.155-1.311a4 4 0 0 0-.116-.416a6.51 6.51 0 0 0 5.445-6.424A9 9 0 0 0 22 9.203a6.13 6.13 0 0 0-1.263-3.826"></path>
                            </svg>
                        </a>
                    )
                }
                <ThemeToggle />
            </div>
        </div>
    </div>
</nav>

<style>
    @reference "tailwindcss";

    .nav-avatar {
        display: block;
        width: 2.75rem;
        height: 2.75rem;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--text-main) 16%, transparent);
        border-radius: 999px;
        background: var(--bg-main);
        transition: border-color 180ms ease;
    }

    .nav-avatar:hover {
        border-color: var(--title-accent);
    }

    .nav-avatar img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .site-nav {
        padding: 1.5rem 0;
    }

    .site-nav-inner {
        display: grid;
        grid-template-columns: auto max-content;
        align-items: center;
        width: 100%;
    }

    .site-nav-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .nav-tools {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .nav-menu-shell {
        position: relative;
        display: flex;
        align-items: center;
    }

    .menu {
        display: flex;
        gap: 1.2rem;
    }

    .menu a {
        cursor: pointer;
        color: var(--text-main);
        text-decoration: none;
        opacity: 0.6;
        outline: none;
        transition: opacity 180ms ease, color 180ms ease;
    }

    .menu a:hover {
        color: var(--text-main);
        opacity: 1;
    }

    .menu a.nav-link-active {
        color: var(--title-accent);
        opacity: 1;
    }

    .menu .nav-link-disabled {
        display: block;
        color: var(--text-main);
        cursor: default;
        opacity: 0.6;
    }

    .nav-icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        color: var(--text-main);
        opacity: 0.6;
        transition: opacity 180ms ease, color 180ms ease;
    }

    .nav-icon-link:hover {
        color: var(--title-accent);
        opacity: 1;
    }

    .nav-icon-link svg {
        width: 1.05rem;
        height: 1.05rem;
        fill: currentColor;
    }

    @media (max-width: 767px) {
        .menu {
            @apply invisible opacity-0;
            width: calc(100% + 1rem);
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transition: opacity 0.18s ease;
        }
        .menu-toggle-icon {
            transition: width 0.12s ease;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.12s ease;
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-6 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                rotate 0.14s ease,
                margin 0.14s ease 0.08s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.14s ease,
                rotate 0.14s ease 0.08s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-avatar {
            transition: none;
        }

        .menu a {
            transition: none;
        }

        .nav-icon-link {
            transition: none;
        }
    }
</style>

<script>
    (() => {
        const setMenuState = (isOpen) => {
            const nav = document.querySelector('nav');
            if (!(nav instanceof HTMLElement)) return;

            const menu = nav.querySelector('.menu');
            const menuToggleBtn = nav.querySelector('.menu-toggle');
            if (!(menu instanceof HTMLElement) || !(menuToggleBtn instanceof HTMLButtonElement)) return;

            menu.classList.toggle('is-visible', isOpen);
            menuToggleBtn.classList.toggle('is-active', isOpen);
            menuToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            menuToggleBtn.setAttribute('aria-label', isOpen ? 'Close Menu' : 'Open Menu');
        };

        const syncMenuState = () => setMenuState(false);

        if (!window.__navMenuBound) {
            document.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const toggle = target.closest('.menu-toggle');
                if (toggle instanceof HTMLButtonElement) {
                    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
                    setMenuState(!isExpanded);
                    return;
                }

                if (target.closest('.menu a')) {
                    syncMenuState();
                    return;
                }

                if (!target.closest('nav')) syncMenuState();
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') syncMenuState();
            });

            document.addEventListener('astro:after-swap', syncMenuState);
            document.addEventListener('astro:page-load', syncMenuState);
            window.__navMenuBound = true;
        } else {
            syncMenuState();
        }

        syncMenuState();
    })();
</script>
