---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks || [];
---

<nav class="site-nav relative py-4 sm:py-5">
    <div class="w-full max-w-2xl mx-auto relative flex items-center justify-between">
        <a href="/" class="brand-title text-xl leading-none font-medium text-main z-30 relative sm:text-2xl" aria-label="Harp83">
            Harp83
        </a>

        <div class="relative flex items-center gap-1">
            {
                navLinks.length > 0 && (
                    <div class="relative flex items-center">
                        <button
                            class="menu-toggle cursor-pointer w-8 h-8 -ml-1 flex items-center justify-center relative z-30 md:hidden"
                            aria-label="Open Menu"
                            aria-expanded="false"
                            aria-controls="menu-items"
                        >
                            <span class="menu-toggle-icon w-6 h-px relative bg-current" />
                        </button>

                        <ul
                            id="menu-items"
                            class="menu flex gap-5 max-md:flex-col max-md:gap-1 max-md:absolute max-md:-top-2 max-md:-right-2 max-md:max-w-64 max-md:px-4 max-md:pt-14 max-md:pb-5 max-md:z-20 max-md:bg-main max-md:border max-md:border-main/10 md:items-center"
                        >
                            {navLinks.map((link) => (
                                <li class="py-1">
                                    <NavLink
                                        class="text-lg font-sans tracking-wide text-main/75 hover:text-main md:text-sm md:tracking-normal"
                                        href={link.href}
                                    >
                                        {link.text}
                                    </NavLink>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
            <ThemeToggle />
        </div>
    </div>
</nav>

<style>
    @reference "tailwindcss";

    .brand-title {
        font-family: 'Newsreader Variable', serif;
        letter-spacing: 0.03em;
        font-style: italic;
        position: relative;
    }

    .brand-title::after {
        content: '';
        position: absolute;
        right: -0.5rem;
        top: 50%;
        width: 0.22rem;
        height: 0.22rem;
        border-radius: 999px;
        background: currentColor;
        transform: translateY(-34%);
        opacity: 0.55;
    }

    .site-nav {
        border-bottom: 0;
    }

    @media (max-width: 767px) {
        .menu {
            @apply invisible opacity-0;
            width: calc(100% + 1rem);
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transition: opacity 0.18s ease;
        }
        .menu-toggle-icon {
            transition: width 0.12s ease;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.12s ease;
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply w-6 h-px absolute left-1/2 top-0 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                rotate 0.14s ease,
                margin 0.14s ease 0.08s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.14s ease,
                rotate 0.14s ease 0.08s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }
</style>

<script>
    (() => {
        const setMenuState = (isOpen) => {
            const nav = document.querySelector('nav');
            if (!(nav instanceof HTMLElement)) return;

            const menu = nav.querySelector('.menu');
            const menuToggleBtn = nav.querySelector('.menu-toggle');
            if (!(menu instanceof HTMLElement) || !(menuToggleBtn instanceof HTMLButtonElement)) return;

            menu.classList.toggle('is-visible', isOpen);
            menuToggleBtn.classList.toggle('is-active', isOpen);
            menuToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            menuToggleBtn.setAttribute('aria-label', isOpen ? 'Close Menu' : 'Open Menu');
        };

        const syncMenuState = () => setMenuState(false);

        if (!window.__navMenuBound) {
            document.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const toggle = target.closest('.menu-toggle');
                if (toggle instanceof HTMLButtonElement) {
                    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
                    setMenuState(!isExpanded);
                    return;
                }

                if (target.closest('.menu a')) {
                    syncMenuState();
                    return;
                }

                if (!target.closest('nav')) syncMenuState();
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') syncMenuState();
            });

            document.addEventListener('astro:after-swap', syncMenuState);
            document.addEventListener('astro:page-load', syncMenuState);
            window.__navMenuBound = true;
        } else {
            syncMenuState();
        }

        syncMenuState();
    })();
</script>
