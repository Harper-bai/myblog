---
/**
 * [INPUT]: 依赖 Astro 分页对象、左右箭头图标与 IconButton
 * [OUTPUT]: 对外提供内容集合的前后翻页控制与当前页语义
 * [POS]: components 的分页编排器；只消费分页结果，不负责集合查询
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import ArrowLeft from '../icons/ArrowLeft.astro';
import ArrowRight from '../icons/ArrowRight.astro';
import IconButton from './IconButton.astro';

const { page, class: className } = Astro.props;
---

<nav aria-label="Pagination" class:list={['px-12 py-2 relative text-center border-t border-main/15', className]}>
    {
        page.url.prev && (
            <IconButton
                class="absolute left-0 top-1/2 -translate-y-1/2"
                href={page.url.prev}
                aria-label={`Go to page ${page.currentPage - 1} of ${page.lastPage}`}
            >
                <ArrowLeft class="w-5 h-5 fill-current" />
            </IconButton>
        )
    }
    <span class="text-sm text-main/70" aria-current="page">
        Page {page.currentPage} of {page.lastPage}
    </span>
    {
        page.url.next && (
            <IconButton
                class="absolute right-0 top-1/2 -translate-y-1/2"
                href={page.url.next}
                aria-label={`Go to page ${page.currentPage + 1} of ${page.lastPage}`}
            >
                <ArrowRight class="w-5 h-5 fill-current" />
            </IconButton>
        )
    }
</nav>
