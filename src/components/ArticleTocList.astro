---
/**
 * [INPUT]: 依赖 ArticleToc 构造的单个目录节点及其子节点
 * [OUTPUT]: 对外提供保持 heading.depth 层级的递归 li/ul 目录项
 * [POS]: components 的文章目录递归视图；不负责目录开关、定位或正文渲染
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import type { MarkdownHeading } from 'astro';

type TocNode = {
    heading: MarkdownHeading;
    children: TocNode[];
};

type Props = {
    node: TocNode;
};

const { node } = Astro.props;
---

<li>
    <a class="toc-link" href={`#${node.heading.slug}`}>{node.heading.text}</a>
    {node.children.length > 0 && (
        <ul>
            {node.children.map((child) => <Astro.self node={child} />)}
        </ul>
    )}
</li>
