---
/**
 * [INPUT]: 依赖站点标题
 * [OUTPUT]: 对外提供许可证协议与版权标注
 * [POS]: components 的全站页尾；只承担内容授权与归属说明，不承载导航或联系方式
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import siteConfig from '../data/site-config';
---

<footer class="footer-shell w-full max-w-2xl mx-auto pt-10 pb-9 sm:pt-12 sm:pb-10">
    <hr class="footer-divider" />

    <p class="footer-meta">
        <a
            class="footer-link"
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            rel="license"
            target="_blank"
        >CC BY-NC-SA 4.0</a>
        <span class="footer-separator" aria-hidden="true"> · </span>
        <span>&copy; {new Date().getFullYear()} <a class="footer-link" href="/">{siteConfig.title}</a></span>
    </p>
</footer>

<style>
    .footer-shell {
        color: color-mix(in srgb, var(--text-main) 64%, transparent);
        font-family: 'Newsreader Variable', serif;
        font-size: 0.92rem;
        line-height: 1.6;
        text-align: center;
    }

    .footer-divider {
        width: 2.5rem;
        margin: 0 auto 1.45rem;
        border: 0;
        border-top: 1px solid color-mix(in srgb, var(--text-main) 25%, transparent);
    }

    .footer-meta {
        margin: 0;
        color: color-mix(in srgb, var(--text-main) 52%, transparent);
    }

    .footer-separator {
        margin: 0 0.3rem;
    }

    .footer-link {
        color: inherit;
        transition: color 0.16s ease;
    }

    .footer-link:hover {
        color: var(--text-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
        .footer-link {
            transition: none;
        }
    }
</style>
