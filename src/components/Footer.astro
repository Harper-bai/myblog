---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks || [];
const navLinks = siteConfig.footerNavLinks || [];
---

<footer class="footer-shell w-full max-w-2xl mx-auto pt-10 pb-9 sm:pt-12 sm:pb-10">
    {
        navLinks.length > 0 && (
            <div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-main/65">
                {navLinks.map((link) => (
                    <a class="footer-link font-serif" href={link.href}>
                        {link.text}
                    </a>
                ))}
            </div>
        )
    }
    <div class:list={['pt-4 flex flex-col gap-3 border-t border-main/10', { 'sm:flex-row sm:items-center sm:justify-between': socialLinks.length > 0 }]}>
        <p class="text-xs font-sans tracking-wide text-main/55 sm:text-sm">
            &copy; {new Date().getFullYear()} <a class="footer-link" href="/">Harp83</a>
        </p>
        {
            socialLinks.length > 0 && (
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm">
                    {socialLinks.map((link) => (
                        <a
                            class="footer-link inline-flex items-center justify-center"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferer"
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</footer>

<style>
    .footer-shell {
        color: color-mix(in srgb, var(--text-main) 78%, transparent);
        font-family: 'Newsreader Variable', serif;
    }

    .footer-link {
        color: inherit;
        transition: color 0.16s ease;
    }

    .footer-link:hover {
        color: var(--text-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
    }
</style>
