---
/**
 * [INPUT]: 依赖 Astro 渲染结果提供的 MarkdownHeading[]，heading.depth 决定目录嵌套层级
 * [OUTPUT]: 对外提供固定桌面目录、语义化菜单按钮与真实嵌套 ul/li 锚点结构
 * [POS]: components 的文章目录渲染器；由文章详情页挂载，不修改正文或全站导航
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import type { MarkdownHeading } from 'astro';
import ArticleTocList from './ArticleTocList.astro';

type TocNode = {
    heading: MarkdownHeading;
    children: TocNode[];
};

type Props = {
    headings: MarkdownHeading[];
};

const { headings } = Astro.props;

function createTocTree(items: MarkdownHeading[]) {
    const roots: TocNode[] = [];
    const stack: TocNode[] = [];

    for (const heading of items) {
        const node: TocNode = { heading, children: [] };

        while (stack.length > 0 && stack.at(-1)!.heading.depth >= heading.depth) {
            stack.pop();
        }

        if (stack.length > 0) {
            stack.at(-1)!.children.push(node);
        } else {
            roots.push(node);
        }

        stack.push(node);
    }

    return roots;
}

const tocTree = createTocTree(headings);
const tocListId = 'article-toc-list';
---

{tocTree.length > 0 && (
    <aside class="table-of-contents" data-article-toc>
        <button
            class="table-of-contents-anchor"
            type="button"
            aria-label="显示文章目录"
            aria-controls={tocListId}
            aria-expanded="false"
            data-toc-toggle
        >
            <span class="toc-menu-icon" aria-hidden="true"></span>
        </button>
        <nav id={tocListId} aria-label="文章目录" class="toc-navigation">
            <ul class="toc-list">
                {tocTree.map((node) => <ArticleTocList node={node} />)}
            </ul>
        </nav>
    </aside>
)}

{tocTree.length > 0 && (
    <script>
        document.querySelectorAll('[data-article-toc]').forEach((toc) => {
            if (!(toc instanceof HTMLElement) || toc.dataset.tocBound) return;

            const toggle = toc.querySelector('[data-toc-toggle]');
            if (!(toggle instanceof HTMLButtonElement)) return;

            const setOpen = (open: boolean) => {
                toc.dataset.tocOpen = String(open);
                toggle.setAttribute('aria-expanded', String(open));
                toggle.setAttribute('aria-label', open ? '隐藏文章目录' : '显示文章目录');
            };

            toggle.addEventListener('click', () => {
                setOpen(toc.dataset.tocOpen !== 'true');
            });

            toc.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    setOpen(false);
                    toggle.focus();
                }
            });

            toc.dataset.tocBound = 'true';
        });
    </script>
)}

<style>
    .table-of-contents {
        position: fixed;
        top: 90px;
        right: auto;
        bottom: 0;
        left: 20px;
        z-index: 200;
        display: none;
        width: 100px;
        flex-direction: column;
        overflow: hidden;
        font-size: 0.8em;
        line-height: 1.75;
    }

    .table-of-contents-anchor {
        display: flex;
        width: 1.75rem;
        height: 1.75rem;
        flex: 0 0 1.75rem;
        align-items: center;
        justify-content: center;
        margin-inline: 0.5rem;
        padding: 0;
        border: 1px solid var(--bg-main);
        border-radius: 0.3rem;
        background: var(--bg-main);
        box-shadow: 0 1px 5px color-mix(in srgb, var(--border-main) 10%, transparent);
        color: color-mix(in srgb, var(--text-main) 48%, transparent);
        cursor: pointer;
        font-size: 1.125rem;
        line-height: 1.5555556;
        transition:
            color 180ms ease,
            border-color 180ms ease,
            box-shadow 180ms ease;
    }

    .toc-menu-icon,
    .toc-menu-icon::before,
    .toc-menu-icon::after {
        display: block;
        width: 0.9rem;
        height: 1px;
        background: currentColor;
        content: '';
    }

    .toc-menu-icon {
        position: relative;
    }

    .toc-menu-icon::before,
    .toc-menu-icon::after {
        position: absolute;
        left: 0;
    }

    .toc-menu-icon::before {
        top: -0.27rem;
    }

    .toc-menu-icon::after {
        top: 0.27rem;
    }

    .toc-navigation {
        height: 100%;
        flex: 1 1 auto;
        min-height: 0;
        margin-top: 0.25rem;
        padding-bottom: 1.25rem;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 400ms ease,
            visibility 400ms ease;
    }

    :global(.toc-list),
    :global(.toc-list ul) {
        height: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .toc-navigation {
        overflow-y: auto;
        scrollbar-width: thin;
    }

    :global(.toc-list li) {
        margin-top: 0.5em;
        padding-left: 0.8rem;
        line-height: 1.5em;
    }

    :global(.toc-list ul) {
        height: auto;
    }

    :global(.toc-link) {
        display: block;
        overflow-wrap: anywhere;
        color: var(--text-main);
        text-decoration: none;
        opacity: 0.75;
        transition: color 180ms ease, opacity 180ms ease;
    }

    :global(.toc-link:hover),
    :global(.toc-link:focus-visible) {
        color: var(--text-main);
        opacity: 1;
    }

    :global(.toc-link:focus-visible),
    .table-of-contents-anchor:focus-visible {
        outline: 2px solid var(--title-accent);
        outline-offset: 2px;
    }

    @media (min-width: 64rem) {
        .table-of-contents {
            display: flex;
            width: 200px;
        }

        .table-of-contents-anchor {
            border-color: transparent;
            box-shadow: none;
        }

        .table-of-contents:hover .table-of-contents-anchor,
        .table-of-contents:focus-within .table-of-contents-anchor,
        .table-of-contents[data-toc-open='true'] .table-of-contents-anchor,
        :global(.article-shell:hover) .table-of-contents-anchor {
            color: var(--text-main);
            border-color: transparent;
            box-shadow: none;
        }

        .table-of-contents:hover .toc-navigation,
        .table-of-contents:focus-within .toc-navigation,
        .table-of-contents[data-toc-open='true'] .toc-navigation,
        :global(.article-shell:hover) .toc-navigation {
            opacity: 0.75;
            visibility: visible;
            pointer-events: auto;
        }

    }

    @media (min-width: 80rem) {
        .table-of-contents {
            width: 300px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .table-of-contents-anchor,
        .toc-navigation,
        :global(.toc-link) {
            transition: none;
        }
    }
</style>
