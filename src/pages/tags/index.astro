---
import { getCollection } from 'astro:content';
import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, sortItemsByDateDesc } from '../../utils/data-utils';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const tags = getAllTags(posts).sort((tagA, tagB) => {
    const postCountTagA = getPostsByTag(posts, tagA.id).length;
    const postCountTagB = getPostsByTag(posts, tagB.id).length;
    return postCountTagB - postCountTagA;
});
---

<BaseLayout
    title="Tags"
    description="Explore tag directory for easy navigation and discovery. Find a wide range of topics, articles, and insights organized by tags, making it effortless to locate the content that interests you most."
    showHeader={false}
>
    <header class="mb-4 border-b border-main/20 pb-3 sm:mb-6">
        <h1 class="text-2xl leading-tight font-cang font-medium sm:text-3xl">Tags</h1>
        <p class="mt-1 text-sm text-main/65">Browse posts by topic.</p>
    </header>
    {tags.length > 0 ? (
        <>
            {tags.map((tag) => {
                const postCount = getPostsByTag(posts, tag.id).length;
                return (
                    <a class="block border-b border-main/10 py-5 last:border-b-0 sm:py-6" href={`/tags/${tag.id}`}>
                        <h2 class="text-xl leading-tight font-cang font-medium sm:text-2xl">{tag.name}</h2>
                        <div class="mt-1 text-sm leading-normal text-main/65">
                            {postCount} {postCount === 1 ? 'post' : 'posts'}
                        </div>
                    </a>
                );
            })}
        </>
    ) : (
        <EmptyState
            title="No tags yet"
            text="Tags will appear automatically as posts are published with tag metadata."
            ctaHref="/blog"
            ctaText="View Blog"
        />
    )}
</BaseLayout>
