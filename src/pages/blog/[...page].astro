---
/**
 * [INPUT]: 依赖 blog 内容集合与日期排序工具，依赖 ArchiveList 与 BaseLayout 组织文章索引
 * [OUTPUT]: 对外提供 Blog 分类列表页，并将集合数据交给共用归档容器
 * [POS]: pages/blog 的数据入口；负责 Blog 集合查询，不承载 Blog/Notes 共用列表的视觉结构
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import { type CollectionEntry, getCollection } from 'astro:content';
import ArchiveList from '../../components/ArchiveList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);

    return [{ params: { page: undefined }, props: { posts } }];
}

type Props = { posts: CollectionEntry<'blog'>[] };

const { posts } = Astro.props;
---

<BaseLayout title="Blog" description="Blog posts and essays" image={{ src: '/dante-preview.jpg', alt: 'The preview of the site' }} showHeader={false}>
    <ArchiveList posts={posts} activeSection="blog" />
</BaseLayout>
