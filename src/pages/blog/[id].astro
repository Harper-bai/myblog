---
/**
 * [INPUT]: 依赖 blog 内容集合中的文章、相邻文章与渲染后的 headings，依赖 BaseLayout、ArticleToc、PostPreview、ReadingTools、Subscribe
 * [OUTPUT]: 对外提供带元信息、响应式目录、正文、相关文章与阅读工具的静态文章详情页
 * [POS]: pages/blog 的文章详情路由；负责组织文章阅读结构，不承载全站主题与内容集合查询实现
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ArticleToc from '../../components/ArticleToc.astro';
import PostPreview from '../../components/PostPreview.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import Subscribe from '../../components/Subscribe.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEstimatedWordCount, getMetaDescription } from '../../utils/common-utils';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'> | null; nextPost: CollectionEntry<'blog'> | null };

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, excerpt, language, seo } = post.data;
const { Content, headings } = await render(post);
const wordCount = getEstimatedWordCount(post.body);

function formatChineseDate(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1);
    const day = String(date.getDate());
    return `${year}年${month}月${day}日`;
}

const fallbackDescription = getMetaDescription(post.body, title);
const description = [seo?.description, excerpt, fallbackDescription].map((value) => value?.trim()).find(Boolean) ?? title;
---

<BaseLayout title={seo?.title ?? title} description={description} image={seo?.image} pageType="article" lang={language === 'en' ? 'en' : 'zh-CN'} showHeader={false}>
    <article class="article-shell mb-10 sm:mb-12" data-reading-root>
        <ArticleToc headings={headings} />
        <header class="article-header">
            <h1 class="article-title">{title}</h1>
            <p class="article-meta">
                <span>{formatChineseDate(publishDate)}</span>
                <span aria-hidden="true">·</span>
                <span>{wordCount}字</span>
            </p>
        </header>
        <div class="article-body prose">
            <Content />
        </div>
    </article>
    {
        (prevPost || nextPost) && (
            <nav class="read-next" aria-label="Read Next">
                <h2 class="read-next-title">Read Next</h2>
                {nextPost && <PostPreview post={nextPost} headingLevel="h3" variant="related" />}
                {prevPost && <PostPreview post={prevPost} headingLevel="h3" variant="related" />}
            </nav>
        )
    }
    <Subscribe class="my-12 sm:my-14" />
    <ReadingTools />
</BaseLayout>

<style>
    /* ---------------------------------------------------------------------
       文章页局部排版：与参考站 prose 的节奏一致，不改变全站内容样式。
       --------------------------------------------------------------------- */
    .article-shell {
        width: min(100%, 65ch);
        margin-inline: auto;
    }

    .article-header {
        margin-bottom: 2rem;
    }

    .article-title {
        margin: 0 0 0.8888889em;
        color: var(--text-main);
        font-family: var(--font-sans);
        font-size: 2.25rem;
        font-weight: 800;
        line-height: 1.1111111;
    }

    .article-meta {
        margin: -1.5rem 0 0;
        color: var(--text-main);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        line-height: 1.5;
        opacity: 0.5;
    }

    .article-meta > span + span {
        margin-left: 0.35rem;
    }

    .article-body.prose {
        max-width: 65ch;
        color: color-mix(in srgb, var(--text-main) 78%, transparent);
        font-family: var(--font-sans);
        font-size: 1rem;
        line-height: 1.75;
    }

    .article-body.prose :global(p) {
        margin-top: 1.25em;
        margin-bottom: 1.25em;
    }

    .article-body.prose :global(a) {
        color: var(--text-main);
        font-weight: inherit;
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--text-main) 30%, transparent);
        transition: border-color 300ms ease-in-out, color 180ms ease;
    }

    .article-body.prose :global(a:hover),
    .article-body.prose :global(a:focus-visible) {
        color: var(--text-main);
        border-color: color-mix(in srgb, var(--text-main) 70%, transparent);
    }

    .article-body.prose :global(h1),
    .article-body.prose :global(h2),
    .article-body.prose :global(h3),
    .article-body.prose :global(h4),
    .article-body.prose :global(h5),
    .article-body.prose :global(h6) {
        scroll-margin-top: 2.5rem;
    }

    .article-body.prose :global(h1) {
        margin-top: 0;
        margin-bottom: 0.8888889em;
        color: var(--text-main);
        font-size: 2.25em;
        font-weight: 800;
        line-height: 1.1111111;
    }

    .article-body.prose :global(h2) {
        margin-top: 2em;
        margin-bottom: 1em;
        color: color-mix(in srgb, var(--text-main) 94%, transparent);
        font-size: 1.5em;
        font-weight: 700;
        line-height: 1.3333333;
    }

    .article-body.prose :global(h3) {
        margin-top: 1.6em;
        margin-bottom: 0.6em;
        color: inherit;
        font-size: 1.25em;
        font-weight: 600;
        line-height: 1.6;
        opacity: 1;
    }

    .article-body.prose :global(h4) {
        margin-top: 1.5em;
        margin-bottom: 0.5em;
        color: inherit;
        font-size: 1em;
        font-weight: 600;
        line-height: 1.5;
    }

    .article-body.prose :global(ol),
    .article-body.prose :global(ul) {
        margin-top: 1.25em;
        margin-bottom: 1.25em;
        list-style-type: none;
    }

    .article-body.prose :global(ol > li),
    .article-body.prose :global(ul > li) {
        position: relative;
        margin-top: 0.5em;
        margin-bottom: 0.5em;
        padding-left: 1.75em;
    }

    .article-body.prose :global(ol > li::before) {
        position: absolute;
        left: 0;
        color: color-mix(in srgb, var(--text-main) 56%, transparent);
        content: counter(list-item, decimal) '.';
        font-weight: 400;
    }

    .article-body.prose :global(ul > li::before) {
        position: absolute;
        top: calc(0.875em - 0.1875em);
        left: 0.25em;
        width: 0.375em;
        height: 0.375em;
        border-radius: 50%;
        background-color: color-mix(in srgb, var(--text-main) 28%, transparent);
        content: '';
    }

    .article-body.prose :global(ul ul),
    .article-body.prose :global(ul ol),
    .article-body.prose :global(ol ul),
    .article-body.prose :global(ol ol) {
        margin-top: 0.75em;
        margin-bottom: 0.75em;
    }

    .article-body.prose :global(blockquote) {
        margin-top: 1.6em;
        margin-bottom: 1.6em;
        padding-left: 1em;
        border-left: 0.25rem solid color-mix(in srgb, var(--text-main) 30%, transparent);
        color: inherit;
        font-weight: 500;
        font-style: italic;
        line-height: 1.6em;
        quotes: '\201C' '\201D' '\2018' '\2019';
    }

    .article-body.prose :global(blockquote > *) {
        opacity: 1;
    }

    .article-body.prose :global(blockquote > :first-child) {
        margin-top: 0;
    }

    .article-body.prose :global(blockquote > :last-child) {
        margin-bottom: 0;
    }

    .article-body.prose :global(blockquote p:first-of-type::before),
    .article-body.prose :global(blockquote p:last-of-type::after) {
        content: none;
    }

    .article-body.prose :global(code) {
        margin: -0.2em 0;
        padding: 0.2em 0.3em;
        border: 0;
        border-radius: 0.25rem;
        background: var(--inline-code-bg);
        color: var(--inline-code-text);
        font-family: var(--font-mono);
        font-size: 0.9em;
        font-weight: 500;
    }

    .article-body.prose :global(pre) {
        max-width: 100%;
        margin-top: 1.714em;
        margin-bottom: 1.714em;
        overflow-x: auto;
        border-radius: 0.375rem;
        background: var(--code-bg);
        color: var(--code-text);
        font-size: 0.875em;
        line-height: 1.714;
    }

    .article-body.prose :global(pre code) {
        margin: 0;
        padding: 0;
        background: transparent;
        color: inherit;
        font-size: inherit;
        font-weight: 400;
        line-height: inherit;
    }

    .article-body.prose :global(pre code::before),
    .article-body.prose :global(pre code::after) {
        content: none;
    }

    .article-body.prose :global(hr) {
        width: 50px;
        margin-top: 3em;
        margin-bottom: 3em;
        margin-inline: auto;
        border-color: color-mix(in srgb, var(--text-main) 30%, transparent);
    }

    .article-body.prose :global(img),
    .article-body.prose :global(video),
    .article-body.prose :global(figure) {
        margin-top: 2em;
        margin-bottom: 2em;
    }

    .article-body.prose :global(figure > *) {
        margin-top: 0;
        margin-bottom: 0;
    }

    .article-body.prose :global(figcaption) {
        margin-top: 0.857em;
        color: color-mix(in srgb, var(--text-main) 60%, transparent);
        font-size: 0.875em;
        line-height: 1.428;
    }

    .article-body.prose > :global(:first-child) {
        margin-top: 0;
    }

    .article-body.prose > :global(:last-child) {
        margin-bottom: 0;
    }

    /* ---------------------------------------------------------------------
       文章尾部回流：与正文同列，用细分隔线取代突兀的独立区块。
       --------------------------------------------------------------------- */
    .read-next {
        width: min(100%, 65ch);
        margin: 2.5rem auto 3rem;
        padding-top: 0.75rem;
        border-top: 1px solid color-mix(in srgb, var(--text-main) 9%, transparent);
    }

    .read-next-title {
        margin: 0 0 0.45rem;
        color: color-mix(in srgb, var(--text-main) 38%, transparent);
        font-family: var(--font-sans);
        font-size: 0.6875rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        line-height: 1.5;
    }

    .read-next .post-preview {
        padding: 0.3rem 0;
    }

    .read-next .post-preview-title {
        color: color-mix(in srgb, var(--text-main) 82%, transparent);
        font-size: 0.9375rem;
        line-height: 1.4;
    }

    .read-next .post-preview-meta {
        color: color-mix(in srgb, var(--text-main) 42%, transparent);
        font-size: 0.6875rem;
    }

    @media (max-width: 63.99rem) {
        .article-shell {
            width: min(calc(100% - 1.5rem), 65ch);
            margin-top: 0.25rem;
        }

        .read-next {
            width: min(calc(100% - 1.5rem), 65ch);
            margin-top: 2rem;
            margin-bottom: 2.5rem;
            padding-top: 0.65rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .article-body.prose :global(a) {
            transition: none;
        }
    }
</style>
