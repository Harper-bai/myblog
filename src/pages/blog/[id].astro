---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import ReadingTools from '../../components/ReadingTools.astro';
import Subscribe from '../../components/Subscribe.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { getEstimatedWordCount, slugify } from '../../utils/common-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, excerpt, tags = [], seo } = post.data;
const { Content, headings } = await render(post);
const wordCount = getEstimatedWordCount(post.body);

function formatChineseDate(date: Date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1);
    const day = String(date.getDate());
    return `${year}年${month}月${day}日`;
}
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-20" data-reading-root>
        <header class="mb-8 border-b border-main/10 pb-4 sm:mb-9 sm:pb-5">
            <h1 class="text-3xl leading-tight font-cang font-medium sm:text-4xl sm:leading-tight">{title}</h1>
            <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-sans text-main/60 sm:text-sm">
                <span>{formatChineseDate(publishDate)}</span>
                <span aria-hidden="true">·</span>
                <span>{wordCount}字</span>
                {
                    tags.length > 0 && (
                        <>
                            <span aria-hidden="true">·</span>
                            <div class="flex flex-wrap items-center gap-x-2">
                                {tags.map((tag) => (
                                    <a class="post-meta-tag" href={`/tags/${slugify(tag)}`}>
                                        #{tag}
                                    </a>
                                ))}
                            </div>
                        </>
                    )
                }
            </div>
        </header>
        <div class="relative">
            {
                headings.length > 0 && (
                    <aside class="mb-6 border-b border-main/8 pb-4 lg:absolute lg:top-0 lg:right-full lg:mr-10 lg:mb-0 lg:w-48 lg:border-0 lg:pb-0">
                        <div class="lg:sticky lg:top-24">
                            <p class="mb-2 text-[11px] tracking-[0.18em] uppercase text-main/40">目录</p>
                            <nav aria-label="文章目录">
                                <ol class="space-y-1.5 text-sm leading-6 text-main/55">
                                    {headings.map((heading) => (
                                        <li class={heading.depth > 2 ? 'pl-3' : ''}>
                                            <a class="toc-link block hover:text-main" href={`#${heading.slug}`}>
                                                {heading.text}
                                            </a>
                                        </li>
                                    ))}
                                </ol>
                            </nav>
                        </div>
                    </aside>
                )
            }
            <div class="article-body max-w-none prose sm:prose-lg">
                <Content />
            </div>
        </div>
    </article>
    {
        (prevPost || nextPost) && (
            <div class="my-14 sm:my-16">
                <h2 class="mb-3 text-base font-serif tracking-wide text-main/75 sm:mb-4">Read Next</h2>
                {nextPost && <PostPreview post={nextPost} headingLevel="h3" />}
                {prevPost && <PostPreview post={prevPost} headingLevel="h3" />}
            </div>
        )
    }
    <Subscribe class="my-12 sm:my-14" />
    <ReadingTools />
</BaseLayout>

<style>
    .post-meta-tag {
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--text-color-main) 28%, transparent);
        transition: border-color 180ms ease, color 180ms ease;
    }

    .post-meta-tag:hover {
        color: var(--text-color-main);
        border-color: color-mix(in srgb, var(--text-color-main) 68%, transparent);
    }

    .toc-link {
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 180ms ease, color 180ms ease;
    }

    .toc-link:hover {
        border-color: color-mix(in srgb, var(--text-color-main) 38%, transparent);
    }
    @media (max-width: 1023px) {
        .toc-link {
            line-height: 1.55;
        }
    }
</style>
