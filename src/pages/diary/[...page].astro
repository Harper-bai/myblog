---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import EmptyState from '../../components/EmptyState.astro';
import Pagination from '../../components/Pagination.astro';
import PostPreview from '../../components/PostPreview.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    let posts: CollectionEntry<'diary'>[] = [];
    try {
        posts = (await getCollection('diary')).sort(sortItemsByDateDesc);
    } catch {
        posts = [];
    }
    return paginate(posts, { pageSize: siteConfig.postsPerPage || 4 });
}

type Props = { page: Page<CollectionEntry<'diary'>> };

const { page } = Astro.props;
const diary = page.data;
---

<BaseLayout
    title="diaries"
    description="Recording my life experiences, thoughts, and reflections in a personal diary."
    image={{ src: '/dante-preview.jpg', alt: 'The preview of the site' }}
    showHeader={false}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif sm:mb-16 sm:text-4xl">Public Diary</h1>

    {diary.length > 0 ? (
        <>
            {diary.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" />)}
            <Pagination page={page} class="my-16 sm:my-24" />
        </>
    ) : (
        <EmptyState
            title="No diary entries yet"
            text="This space keeps weekly reflections and personal logs. Entries will appear as they are published."
            ctaHref="/blog"
            ctaText="Read Blog Archive"
        />
    )}
    <!-- <Subscribe class="my-16 sm:my-24" /> -->
</BaseLayout>
